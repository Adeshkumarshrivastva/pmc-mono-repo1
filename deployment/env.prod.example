# Production env template for the Hostinger VPS deployment.
#
# On the VPS: copy this to the REPO ROOT as `.env` (not inside deployment/) —
# that's the path every docker-compose service's `env_file: ../.env` and the
# `${...}` build-arg substitutions resolve against.
#
#   cp deployment/env.prod.example .env
#   nano .env
#
# Never commit the filled-in .env — it's already covered by the root .gitignore's `.env*` rule.

# ─────────────────────────────────────────────────────────────
# Infra: domain, TLS, self-hosted Mongo/MinIO
# ─────────────────────────────────────────────────────────────

DOMAIN=srv1909662.hstgr.cloud
# Email Let's Encrypt uses for expiry/problem notices about this cert.
ACME_EMAIL=adeshkumarshrivastva@gmail.com

# MinIO root credentials. Generate with: openssl rand -hex 16
MINIO_ROOT_USER=
# 8+ chars, MinIO will refuse a shorter password.
MINIO_ROOT_PASSWORD=

# ─────────────────────────────────────────────────────────────
# apps/server (Bun + Hono API, mounted at /server)
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000

# Self-hosted Mongo, single-node replica set on the internal docker network — leave as-is.
DATABASE_URL=mongodb://mongo:27017/server?replicaSet=rs0

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_EMAIL=

# server/portal and landing-page use DIFFERENT Razorpay accounts — kept as
# separate prefixed vars here, mapped back to plain RAZORPAY_KEY_ID/SECRET
# per-service via `environment:` in docker-compose.prod.yml, so one doesn't
# clobber the other in the shared container environment.
SERVER_RAZORPAY_KEY_ID=
SERVER_RAZORPAY_KEY_SECRET=
LANDING_RAZORPAY_KEY_ID=
LANDING_RAZORPAY_KEY_SECRET=

WHATSAPP_API_KEY_SECRET=
WHATSAPP_LICENCE_NUMBER_SECRET=
WHATSAPP_TEST_NUMBER_SECRET=

EMAIL_SENDER=
SMS_API_BASE_URL=
SMS_UNAME=
SMS_PASS=
SMS_SENDER_ID=

# Existing Browserless.io (or similar) websocket endpoint — unrelated to this VPS.
BROWSERLESS_WS_ENDPOINT=

# Self-hosted MinIO bucket for server-side file uploads. Access key/secret must
# match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above (plain-text .env files don't
# expand ${...} references to each other, so duplicate the values here).
S3_BUCKET=server-files
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false

CORS_ORIGIN=https://srv1909662.hstgr.cloud

# ─────────────────────────────────────────────────────────────
# apps/landing-page (Next.js + Payload CMS, mounted at /)
# ─────────────────────────────────────────────────────────────

# Self-hosted Mongo, separate logical database from the server's — leave as-is.
PAYLOAD_DB_URL=mongodb://mongo:27017/payload?replicaSet=rs0
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Self-hosted MinIO bucket for Payload media. Same credentials as S3_ACCESS_KEY/
# S3_SECRET_KEY above (same MinIO instance, must match MINIO_ROOT_USER/PASSWORD).
PAYLOAD_BUCKET=payload-media
PAYLOAD_BUCKET_REGION=us-east-1
PAYLOAD_BUCKET_ACCESS_KEY=
PAYLOAD_BUCKET_SECRET_KEY=
PAYLOAD_BUCKET_ENDPOINT=http://minio:9000

# NEXT_PUBLIC_RAZORPAY_KEY_ID should match LANDING_RAZORPAY_KEY_ID above (same account).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

API_BASE_URL=https://srv1909662.hstgr.cloud
NEXT_PUBLIC_API_BASE_URL=https://srv1909662.hstgr.cloud

ONESIGNAL_APP_API_KEY=
# (WHATSAPP_* vars are shared with the server section above — same values, one copy.)

# ─────────────────────────────────────────────────────────────
# apps/portal (Vite SPA, mounted at /portal — baked in at BUILD time,
# so re-run `docker compose build portal` after changing these)
# ─────────────────────────────────────────────────────────────

VITE_PUBLIC_API_BASE_URL=https://srv1909662.hstgr.cloud
# Should match SERVER_RAZORPAY_KEY_ID above (portal uses the server's account).
VITE_PUBLIC_RAZORPAY_KEY_ID=
