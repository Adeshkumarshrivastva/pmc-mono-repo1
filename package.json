{
  "name": "pmc",
  "version": "1.0.0",
  "scripts": {
    "clean": "rimraf node_modules **/*/node_modules",
    "format": "concurrently \"prettier --write --ignore-path .gitignore --cache *.json *.ts\" \"turbo run format\"",
    "lint": "turbo lint",
    "build": "turbo build",
    "dev": "turbo dev"
  },
  "keywords": [],
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "sst": "3.19.1"
  },
  "devDependencies": {
    "@pmc/config": "workspace:*",
    "@types/aws-lambda": "8.10.150",
    "@types/node": "24.0.3",
    "concurrently": "9.1.2",
    "prettier": "3.5.3",
    "rimraf": "6.0.1",
    "turbo": "2.5.4",
    "typescript": "5.8.3"
  }
}
