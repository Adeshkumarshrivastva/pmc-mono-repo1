{
  "name": "@pmc/landing-page",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build --experimental-build-mode compile",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --cache --write --ignore-path .gitignore --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js}\" *.{ts,tsx,js}",
    "payload:generate-types": "cross-env PAYLOAD_CONFIG_PATH=src/payload/config.ts payload generate:types",
    "payload:generate-importmap": "cross-env PAYLOAD_CONFIG_PATH=src/payload/config.ts payload generate:importmap",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@hookform/resolvers": "5.1.1",
    "@next/third-parties": "16.1.6",
    "@payloadcms/db-mongodb": "3.85.0",
    "@payloadcms/next": "3.85.0",
    "@payloadcms/payload-cloud": "3.85.0",
    "@payloadcms/plugin-import-export": "3.85.0",
    "@payloadcms/richtext-lexical": "3.85.0",
    "@payloadcms/storage-s3": "3.85.0",
    "@payloadcms/ui": "3.85.0",
    "@radix-ui/react-aspect-ratio": "1.1.7",
    "@radix-ui/react-checkbox": "1.3.2",
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-hover-card": "1.1.14",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-radio-group": "1.3.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.12",
    "@radix-ui/react-toggle": "1.1.9",
    "@t3-oss/env-nextjs": "0.13.8",
    "@tailwindcss/postcss": "4.1.10",
    "@tanstack/react-query": "5.81.2",
    "@uidotdev/usehooks": "2.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cross-env": "7.0.3",
    "date-fns": "4.1.0",
    "embla-carousel-auto-scroll": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "graphql": "16.8.1",
    "lucide-react": "0.523.0",
    "next": "15.4.11",
    "payload": "3.85.0",
    "postcss": "8.5.6",
    "razorpay": "2.9.6",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "react-hook-form": "7.60.0",
    "react-onesignal": "3.4.6",
    "sharp": "0.32.6",
    "sonner": "2.0.6",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.10",
    "ts-pattern": "5.0.5",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@pmc/config": "workspace:*",
    "@tailwindcss/typography": "0.5.16",
    "@types/node": "24.0.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "eslint": "9.29.0",
    "eslint-config-next": "15.4.11",
    "prettier": "3.5.3",
    "tw-animate-css": "1.3.6",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": "18.20.2 || >=20.9.0",
    "pnpm": "9 || 10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
