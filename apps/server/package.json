{
  "name": "@pmc/server",
  "scripts": {
    "prebuild": "prisma generate",
    "build:server": "bun run scripts/build.ts",
    "start:server": "bun run dist/index.js",
    "format": "prettier --write --ignore-path .gitignore --cache .",
    "lint": "eslint --cache .",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx ./prisma/seed/index.ts"
  },
  "types": "./src/types.ts",
  "module": "./src/types.ts",
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.891.0",
    "@googleapis/calendar": "12.0.0",
    "@hono/zod-validator": "0.7.2",
    "@prisma/client": "6.14.0",
    "@react-email/components": "0.5.3",
    "@react-email/render": "1.2.3",
    "better-auth": "1.3.6",
    "cli-progress": "3.12.0",
    "dayjs": "1.11.18",
    "fractional-indexing": "3.2.0",
    "google-auth-library": "10.4.0",
    "hono": "4.8.0",
    "minio": "8.0.6",
    "nanoid": "5.1.5",
    "pino": "9.9.0",
    "pino-pretty": "13.1.1",
    "prisma": "6.14.0",
    "puppeteer": "24.23.0",
    "razorpay": "2.9.6",
    "react": "19.1.0",
    "thread-stream": "^4.0.0",
