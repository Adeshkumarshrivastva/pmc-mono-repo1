generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EXPERT
  PATIENT
  ADMIN
}

model User {
  id                  String         @id @map("_id")
  name                String?
  email               String
  emailVerified       Boolean
  image               String?
  createdAt           DateTime
  updatedAt           DateTime
  phoneNumber         String?
  phoneNumberVerified Boolean?
  sessions            Session[]
  accounts            Account[]
  experts             Expert[]
  patients            Patient[]
  role                UserRole       @default(PATIENT)
  notifications       Notification[]

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum ExpertType {
  PSYCHOLOGIST
  PSYCHIATRIST
  CLINICAL_PSYCHOLOGIST
  CONSULTANT_PHYSICIAN
  REHABILITATION_PSYCHOLOGIST
  COUNSELLING_PSYCHOLOGIST
}

enum ExpertGender {
  MALE
  FEMALE
}

model Expert {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id])
  userId            String               @unique
  slug              String               @unique
  name              String
  image             String?
  type              ExpertType
  timezone          String               @default("Asia/Kolkata")
  city              String
  country           String
  avgRating         Int                  @default(5)
  // TODO: Add profile fields
  bio               String?
  qualifications    String?
  servicesProvided  Service[]
  availability      ExpertAvailability[]
  blockedDates      ExpertBlockDates[]
  bookings          Booking[]
  payments          Payment[]
  expertise         String[]
  gender            ExpertGender
  experienceInYears Int?
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model ExpertAvailability {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  expert       Expert    @relation(fields: [expertId], references: [id])
  expertId     String    @db.ObjectId
  dayOfTheWeek DayOfWeek
  // isActive is used to provide a toggle button to show whether is availability
  // is active or not, instead of deleting the availability, expert can toggle its state
  isActive     Boolean   @default(true)
  // both startTime and endTime are the utc time value for the hour and minute of the day
  // the date would be 1 Jan 2025
  startTime    DateTime
  endTime      DateTime

  @@index([expertId, dayOfTheWeek, startTime, endTime])
}

model ExpertBlockDates {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expert    Expert   @relation(fields: [expertId], references: [id])
  expertId  String   @db.ObjectId
  // date would be utc date with hour and minute as 0 (start of the day)
  startDate DateTime
  endDate   DateTime

  @@index([expertId, startDate, endDate])
}

enum ServiceMode {
  IN_PERSON
  VIRTUAL
}

model Service {
  id                        String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  name                      String
  slug                      String
  expert                    Expert        @relation(fields: [expertId], references: [id])
  expertId                  String        @db.ObjectId
  availableModes            ServiceMode[] @default([IN_PERSON, VIRTUAL])
  inPersonLocation          Json?
  city                      String
  country                   String
  description               String        @default("")
  bufferTimeBeforeInMinutes Int           @default(30)
  bufferTimeAfterInMinutes  Int           @default(30)
  price                     Float
  currency                  String        @default("INR")
  isPartialPaymentAvailable Boolean       @default(false)
  minPaymentAmount          Float?        @default(0)
  durationInMinutes         Int           @default(60)
  booking                   Booking[]
  payments                  Payment[]
  tags                      String[]
  prebookingQuestions       Json?
  isDeleted                 Boolean       @default(false)

  @@unique([expertId, slug])
  @@index([expertId])
  @@index([tags])
  @@index([availableModes])
}

model Patient {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  userId    String    @unique
  timezone  String    @default("Asia/Kolkata")
  bookings  Booking[]
  payments  Payment[]
}

enum BookingStatus {
  DRAFT
  BOOKED
  CANCELLED
  RESCHEDULED
  COMPLETED
  NOSHOW
}

model Booking {
  id                               String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt                        DateTime      @default(now())
  updatedAt                        DateTime      @updatedAt
  status                           BookingStatus @default(DRAFT)
  expert                           Expert        @relation(fields: [expertId], references: [id])
  expertId                         String        @db.ObjectId
  patient                          Patient       @relation(fields: [patientId], references: [id])
  patientId                        String        @db.ObjectId
  patientName                      String
  patientEmail                     String?
  service                          Service       @relation(fields: [serviceId], references: [id])
  serviceId                        String        @db.ObjectId
  serviceName                      String
  servicePrice                     Float
  serviceCurrency                  String
  serviceDurationInMinutes         Int
  serviceBufferTimeBeforeInMinutes Int
  serviceBufferTimeAfterInMinutes  Int
  parentBookingId                  String?       @db.ObjectId
  preBookingQnA                    Json?
  // utc format
  startDateTime                    DateTime
  endDateTime                      DateTime
  timezone                         String?       @default("Asia/Kolkata")
  mode                             ServiceMode
  isNoShow                         Boolean       @default(false)
  noShowBy                         UserRole?

  inPersonLocation Json?
  virtualLocation  Json?

  payments     Payment[]
  prescription Prescription[]

  calendarEventId String?

  @@index([expertId, serviceId])
  @@index([expertId, startDateTime, endDateTime])
}

model Prescription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String   @db.ObjectId
  notes     String?
  medicines Json[]
}

// TODO: Add BookingHistory
// TODO: Add BookingFeedback

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  status           PaymentStatus @default(PENDING)
  expert           Expert        @relation(fields: [expertId], references: [id])
  expertId         String        @db.ObjectId
  patient          Patient       @relation(fields: [patientId], references: [id])
  patientId        String        @db.ObjectId
  service          Service       @relation(fields: [serviceId], references: [id])
  serviceId        String        @db.ObjectId
  serviceName      String
  servicePrice     Float
  serviceCurrency  String
  booking          Booking       @relation(fields: [bookingId], references: [id])
  bookingId        String        @db.ObjectId
  // TODO: Add razorpay fields
  razorpayOrderId  String?       @unique
  amountPaid       Float
  amountCurrency   String
  isPartialPayment Boolean

  @@index([expertId, serviceId, bookingId])
  @@index([isPartialPayment])
  @@index([servicePrice])
  @@index([amountPaid])
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
}

model Notification {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  type       NotificationType
  metadata   Json?
  reciever   User             @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String           @unique
  readAt     DateTime?
}
