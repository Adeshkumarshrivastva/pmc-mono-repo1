generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EXPERT
  PATIENT
  ADMIN
}

model User {
  id                  String         @id @map("_id")
  name                String?
  email               String
  emailVerified       Boolean
  image               String?
  createdAt           DateTime
  updatedAt           DateTime
  phoneNumber         String?
  phoneNumberVerified Boolean?
  sessions            Session[]
  accounts            Account[]
  experts             Expert[]
  patients            Patient[]
  role                UserRole       @default(PATIENT)
  notifications       Notification[]

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum ExpertType {
  PSYCHOLOGIST
  PSYCHIATRIST
  CLINICAL_PSYCHOLOGIST
  CONSULTANT_PHYSICIAN
  REHABILITATION_PSYCHOLOGIST
  COUNSELLING_PSYCHOLOGIST
  NEUROLOGIST
  GENERAL_PHYSICIAN
  OTHER
}

enum ExpertGender {
  MALE
  FEMALE
}

model Expert {
  id                       String               @id @default(auto()) @map("_id") @db.ObjectId
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  user                     User                 @relation(fields: [userId], references: [id])
  userId                   String               @unique
  slug                     String               @unique
  name                     String
  image                    String?
  type                     ExpertType
  timezone                 String               @default("Asia/Kolkata")
  city                     String
  country                  String
  avgRating                Int                  @default(5)
  bio                      String?
  qualifications           String?
  professionalSnapshot     String[]
  education                ExpertEducation[]
  professionalRegistration String?
  whyChooseUs              String[]
  whatToExpect             String[]
  faqs                     ExpertFaq[]
  servicesProvided         Service[]
  availability             ExpertAvailability[]
  blockedDates             ExpertBlockDates[]
  bookings                 Booking[]
  payments                 Payment[]
  expertise                String[]
  gender                   ExpertGender
  experienceInYears        Int?
  file                     File?                @relation(fields: [photoId], references: [id])
  photoId                  String?              @db.ObjectId
  isDeleted                Boolean              @default(false)
  order                    String
}

type ExpertFaq {
  question String
  answer   String
}

type ExpertEducation {
  degree      String
  institution String
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model ExpertAvailability {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  expert       Expert    @relation(fields: [expertId], references: [id])
  expertId     String    @db.ObjectId
  dayOfTheWeek DayOfWeek
  // isActive is used to provide a toggle button to show whether is availability
  // is active or not, instead of deleting the availability, expert can toggle its state
  isActive     Boolean   @default(true)
  // both startTime and endTime are the utc time value for the hour and minute of the day
  // the date would be 1 Jan 2025
  startTime    DateTime
  endTime      DateTime

  @@index([expertId, dayOfTheWeek, startTime, endTime])
}

model ExpertBlockDates {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expert    Expert   @relation(fields: [expertId], references: [id])
  expertId  String   @db.ObjectId
  // date would be utc date with hour and minute as 0 (start of the day)
  startDate DateTime
  endDate   DateTime

  @@index([expertId, startDate, endDate])
}

enum ServiceMode {
  IN_PERSON
  VIRTUAL
}

enum PaymentMode {
  ONLINE
  OFFLINE
}

model Service {
  id                        String              @id @default(auto()) @map("_id") @db.ObjectId
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  name                      String
  slug                      String
  expert                    Expert              @relation(fields: [expertId], references: [id])
  expertId                  String              @db.ObjectId
  availableModes            ServiceMode[]       @default([IN_PERSON, VIRTUAL])
  inPersonLocation          Json?
  city                      String
  country                   String
  description               String              @default("")
  bufferTimeBeforeInMinutes Int                 @default(30)
  bufferTimeAfterInMinutes  Int                 @default(30)
  price                     Float
  additionalCharges         AdditionalCharges[]
  currency                  String              @default("INR")
  isPartialPaymentAvailable Boolean             @default(false)
  minPaymentAmount          Float?              @default(0)
  durationInMinutes         Int                 @default(60)
  booking                   Booking[]
  payments                  Payment[]
  paymentMode               PaymentMode         @default(ONLINE)
  tags                      String[]
  prebookingQuestions       Json?
  isDeleted                 Boolean             @default(false)

  @@unique([expertId, slug])
  @@index([expertId])
  @@index([tags])
  @@index([availableModes])
}

type AdditionalCharges {
  startTime   DateTime
  endTime     DateTime
  price       Float
  description String
}

model Patient {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  name        String
  email       String?
  phoneNumber String
  user        User      @relation(fields: [userId], references: [id])
  userId      String    @unique
  timezone    String    @default("Asia/Kolkata")
  bookings    Booking[]
  payments    Payment[]
}

enum BookingStatus {
  DRAFT
  BOOKED
  CANCELLED
  RESCHEDULED
  COMPLETED
  NOSHOW
}

model Booking {
  id                               String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt                        DateTime      @default(now())
  updatedAt                        DateTime      @updatedAt
  status                           BookingStatus @default(DRAFT)
  expert                           Expert        @relation(fields: [expertId], references: [id])
  expertId                         String        @db.ObjectId
  patient                          Patient       @relation(fields: [patientId], references: [id])
  patientId                        String        @db.ObjectId
  patientName                      String
  patientEmail                     String?
  service                          Service       @relation(fields: [serviceId], references: [id])
  serviceId                        String        @db.ObjectId
  serviceName                      String
  servicePrice                     Float
  serviceCurrency                  String
  serviceDurationInMinutes         Int
  serviceBufferTimeBeforeInMinutes Int
  serviceBufferTimeAfterInMinutes  Int
  parentBookingId                  String?       @db.ObjectId
  preBookingQnA                    Json?
  // utc format
  startDateTime                    DateTime
  endDateTime                      DateTime
  timezone                         String?       @default("Asia/Kolkata")
  mode                             ServiceMode
  isNoShow                         Boolean       @default(false)
  noShowBy                         UserRole?

  inPersonLocation Json?
  virtualLocation  Json?

  payments     Payment[]
  prescription Prescription[]

  calendarEventId String?

  @@index([expertId, serviceId])
  @@index([expertId, startDateTime, endDateTime])
}

model Prescription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String   @db.ObjectId
  notes     String?
  medicines Json[]
}

// TODO: Add BookingHistory
// TODO: Add BookingFeedback

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  status           PaymentStatus @default(PENDING)
  expert           Expert        @relation(fields: [expertId], references: [id])
  expertId         String        @db.ObjectId
  patient          Patient       @relation(fields: [patientId], references: [id])
  patientId        String        @db.ObjectId
  service          Service       @relation(fields: [serviceId], references: [id])
  serviceId        String        @db.ObjectId
  serviceName      String
  servicePrice     Float
  serviceCurrency  String
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId        String        @db.ObjectId
  // TODO: Add razorpay fields
  razorpayOrderId  String?       @unique
  amountPaid       Float
  amountCurrency   String
  isPartialPayment Boolean
  paymentMode      PaymentMode

  @@index([expertId, serviceId, bookingId])
  @@index([isPartialPayment])
  @@index([servicePrice])
  @@index([amountPaid])
  @@index([paymentMode])
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
}

model Notification {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  type       NotificationType
  metadata   Json?
  reciever   User             @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId String           @unique
  readAt     DateTime?
}

model File {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bucket    String
  fileName  String
  mimeType  String
  size      Int
  Expert    Expert[]
  courseMaterial CourseMaterial?
}

// ---------------------------------------------------------------------------
// Academy
//
// Ported from the standalone academy-demo backend (Express + Mongoose), where
// each of the five kinds of course was its own Mongoose model over a shared,
// byte-identical schema — Webinar, OnlineCourse, HybridCourse, OnlineClass,
// OfflineCourse. Five collections that differ only by name buy nothing here:
// every query would be a five-way branch on a route param, and Enrollment
// already stored the kind as a `courseType` string field rather than deriving
// it from the collection. So the kind is data, and it is one model.
// ---------------------------------------------------------------------------

enum AcademyCourseType {
  WEBINAR
  ONLINE_COURSE
  HYBRID_COURSE
  ONLINE_CLASS
  OFFLINE_COURSE
}

enum AcademyCourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

model AcademyCourse {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  type      AcademyCourseType
  emoji     String             @default("")
  title     String
  desc      String
  duration  String
  // Display strings carried over from the demo verbatim ("12,000 enrolled",
  // "4.9★", "4,999"). They are copy, not quantities: nothing computes with
  // them, and `price` never reaches a payment — Razorpay orders are raised
  // against CourseMaterial.price, which is a real number. Left as-is so the
  // ported API answers byte-identically to the demo it replaces; worth
  // normalising to Int/Float/Decimal the day something needs to sort or sum.
  students  String             @default("0 enrolled")
  rating    String             @default("0★")
  price     String
  oldPrice  String             @default("")
  level     AcademyCourseLevel @default(ALL_LEVELS)
  isActive  Boolean            @default(true)

  // Every read is "the live courses of one kind, oldest first".
  @@index([type, isActive, createdAt])
  enrollments Enrollment[]
}

// ---------------------------------------------------------------------------
// Academy — enrollments, paid materials, quizzes, certificates.
//
// Ported from the same standalone academy-demo backend as AcademyCourse
// above, replacing its Enrollment / CourseMaterial / Purchase / QuizAttempt /
// CourseCertificate Mongoose models. The demo's trust-based "I've Paid" QR
// flow is replaced here with a real Razorpay order (see academy.service.ts
// and webhooks.service.ts) — everything else is a faithful port.
// ---------------------------------------------------------------------------

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
}

model Enrollment {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  // Plain string, not a relation — carries either a real `user.id` from the
  // main auth system or a migrated legacy academy user id. Mirrors how
  // Purchase/QuizAttempt below key off `identity` rather than a hard FK.
  userId     String
  course     AcademyCourse     @relation(fields: [courseId], references: [id])
  courseId   String            @db.ObjectId
  courseType AcademyCourseType
  courseTitle String
  price      String            @default("")
  status     EnrollmentStatus  @default(ACTIVE)
  progress   Int               @default(0)
  lastAccessedAt DateTime?
  enrolledAt DateTime          @default(now())

  @@unique([userId, courseId])
}

// A single uploaded course resource (PDF/PPT) for the Online Course page —
// the file itself lives in the shared `File`/MinIO store, this just carries
// the academy-specific metadata (price, sequential-course ordering).
model CourseMaterial {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime @default(now())
  title       String
  // The original upload name shown to learners — distinct from `file.fileName`,
  // which is the storage path (`files/<date>/<name>_<randomId>`) and not meant
  // for display.
  fileName    String
  file        File     @relation(fields: [fileId], references: [id])
  fileId      String   @unique @db.ObjectId
  // Rupees, charged to unlock download. Order 0 (free preview) and order 2+
  // of a sequential course (earned by quiz, not paid) are both priced 0 by
  // the upload flow — see academy.service.ts.
  price       Int      @default(99)
  uploadedBy  String?
  // Sequential-course grouping: materials sharing `courseGroup` unlock in
  // `order` (1, 2, 3…) — see hasAccess() in academy.access.ts.
  courseGroup String?
  order       Int?

  purchases    Purchase[]
  quizAttempts QuizAttempt[]

  @@index([courseGroup, order])
}

model Purchase {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime       @default(now())
  // `user:<id>` (logged in) or `guest:<uuid>` — identical scheme to the
  // academy-demo, so a visitor can buy without an account.
  identity   String
  material   CourseMaterial @relation(fields: [materialId], references: [id])
  materialId String         @db.ObjectId

  // Details collected just before payment (pre-filled from profile, editable).
  name   String
  email  String
  phone  String
  reason String // "Why are you interested in this course?"

  amount   Int // rupees
  currency String @default("INR")

  status          PurchaseStatus @default(PENDING)
  razorpayOrderId String?        @unique
  paidAt          DateTime?

  @@index([identity, materialId, status])
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
}

// A user's attempt at the certification quiz for a given CourseMaterial.
model QuizAttempt {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  createdAt  DateTime       @default(now())
  // Mirrors Purchase.identity — `user:<id>` or `guest:<uuid>`.
  identity   String
  material   CourseMaterial @relation(fields: [materialId], references: [id])
  materialId String         @db.ObjectId

  score  Int // number of correct answers
  total  Int // total questions
  passed Boolean

  certificateId String? // set once a certificate has been issued

  @@index([identity, materialId])
}

// The final, whole-course certificate — separate from the per-part
// QuizAttempt records above. Earned by passing the final bundle assessment
// (every part's MCQs together, plus a required long-answer submission) once
// every part in the courseGroup has already been individually passed.
model CourseCertificate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt   DateTime @default(now())
  identity    String
  courseGroup String

  score  Int // MCQ correct count
  total  Int
  passed Boolean

  longAnswer String @default("") // not auto-graded, kept for record/review

  certificateId String? // set once issued

  @@index([identity, courseGroup])
}
