generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EXPERT
  PATIENT
  ADMIN
}

model User {
  id                  String    @id @map("_id")
  name                String?
  email               String
  emailVerified       Boolean
  image               String?
  createdAt           DateTime
  updatedAt           DateTime
  phoneNumber         String?
  phoneNumberVerified Boolean?
  sessions            Session[]
  accounts            Account[]
  experts             Expert[]
  patients            Patient[]
  role                UserRole  @default(PATIENT)

  @@unique([email])
  @@unique([phoneNumber])
  @@map("user")
}

model Session {
  id        String   @id @map("_id")
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @map("_id")
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @map("_id")
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum ExpertType {
  PSYCHOLOGIST
  PSYCHIATRIST
  CLINICAL_PSYCHOLOGIST
}

model Expert {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id])
  userId           String               @unique
  slug             String               @unique
  name             String
  type             ExpertType
  timezone         String               @default("Asia/Kolkata")
  city             String
  country          String
  avgRating        Int                  @default(5)
  // TODO: Add profile fields
  bio              String?
  qualifications   String?
  servicesProvided Service[]
  availability     ExpertAvailability[]
  blockedDates     ExpertBlockDates[]
  bookings         Booking[]
  payments         Payment[]
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model ExpertAvailability {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  expert       Expert    @relation(fields: [expertId], references: [id])
  expertId     String    @db.ObjectId
  dayOfTheWeek DayOfWeek
  isActive     Boolean   @default(true)
  // both startTime and endTime are the utc time value for the hour and minute of the day
  // the date would be 1 Jan 2025
  startTime    DateTime
  endTime      DateTime

  @@index([expertId, dayOfTheWeek, startTime, endTime])
}

model ExpertBlockDates {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expert    Expert   @relation(fields: [expertId], references: [id])
  expertId  String   @db.ObjectId
  // date would be utc date with hour and minute as 0 (start of the day)
  startDate DateTime
  endDate   DateTime

  @@index([expertId, startDate, endDate])
}

enum ServiceMode {
  IN_PERSON
  VIRTUAL
}

model Service {
  id                        String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  name                      String
  expert                    Expert        @relation(fields: [expertId], references: [id])
  expertId                  String        @db.ObjectId
  availableModes            ServiceMode[] @default([IN_PERSON, VIRTUAL])
  inPersonLocation          Json?
  // TODO: Add service detail field
  city                      String
  country                   String
  description               String        @default("")
  bufferTimeBeforeInMinutes Int           @default(0)
  bufferTimeAfterInMinutes  Int           @default(0)
  price                     Float
  currency                  String        @default("INR")
  isPartialPaymentAvailable Boolean       @default(false)
  minPaymentAmount          Float?        @default(0)
  durationInMinutes         Int           @default(60)
  booking                   Booking[]
  payments                  Payment[]
  tags                      String[]

  @@index([expertId])
  @@index([tags])
  @@index([availableModes])
}

model Patient {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  userId    String    @unique
  timezone  String    @default("Asia/Kolkata")
  bookings  Booking[]
  payments  Payment[]
}

enum BookingStatus {
  DRAFT
  BOOKED
  CANCELLED
  RESCHEDULED
  COMPLETED
}

model Booking {
  id                               String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt                        DateTime      @default(now())
  updatedAt                        DateTime      @updatedAt
  status                           BookingStatus @default(DRAFT)
  expert                           Expert        @relation(fields: [expertId], references: [id])
  expertId                         String        @db.ObjectId
  patient                          Patient       @relation(fields: [patientId], references: [id])
  patientId                        String        @db.ObjectId
  service                          Service       @relation(fields: [serviceId], references: [id])
  serviceId                        String        @db.ObjectId
  serviceName                      String
  servicePrice                     Float
  serviceCurrency                  String
  serviceDurationInMinutes         Int
  serviceBufferTimeBeforeInMinutes Int
  serviceBufferTimeAfterInMinutes  Int
  parentBookingId                  String?       @db.ObjectId
  // utc format
  startDateTime                    DateTime
  endDateTime                      DateTime
  mode                             ServiceMode
  isNoShow                         Boolean       @default(false)
  noShowBy                         UserRole?
  inPersonLocation                 Json?
  virtualLocation                  Json?
  payments                         Payment[]

  @@index([expertId, serviceId])
  @@index([expertId, startDateTime, endDateTime])
}

// TODO: Add BookingHistory
// TODO: Add BookingFeedback

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  status           PaymentStatus @default(PENDING)
  expert           Expert        @relation(fields: [expertId], references: [id])
  expertId         String        @db.ObjectId
  patient          Patient       @relation(fields: [patientId], references: [id])
  patientId        String        @db.ObjectId
  service          Service       @relation(fields: [serviceId], references: [id])
  serviceId        String        @db.ObjectId
  serviceName      String
  servicePrice     Float
  serviceCurrency  String
  booking          Booking       @relation(fields: [bookingId], references: [id])
  bookingId        String        @db.ObjectId
  // TODO: Add razorpay fields
  razorpayOrderId  String        @unique
  amountPaid       Float
  amountCurrency   String
  isPartialPayment Boolean

  @@index([expertId, serviceId, bookingId])
  @@index([isPartialPayment])
  @@index([servicePrice])
  @@index([amountPaid])
}
